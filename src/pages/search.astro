---
import Search from "astro-pagefind/components/Search.astro";
import { _t } from "@/config";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title={_t.search.title} description={_t.search.desc} noindex>
  <main id="main-content">
    <h1 class="sr-only">{_t.search.title}</h1>
    <div id="search-stack">
      <div id="search-skeleton" aria-hidden="true">
        <div class="skeleton-input"></div>
      </div>
      <div id="search">
        <Search
          instance="search"
          className="pagefind-ui"
          searchboxOptions={{ placeholder: _t.search.title }}
        />
      </div>
    </div>
  </main>
</BaseLayout>

<style is:global>
  input {
    font-size: var(--font-size-md);
  }
  .pagefind-ui {
    --pf-text: var(--color-900);
    --pf-background: var(--color-100);
    --pf-border: var(--color-500);
    --pf-border-focus: var(--color-900);
    --pf-mark: var(--color-900);
  }

  @keyframes shimmer {
    0% {
      background-position: -400px 0;
    }
    100% {
      background-position: 400px 0;
    }
  }

  #search-stack {
    display: grid;
    padding: 0.75rem 0;
  }

  #search-stack > * {
    grid-area: 1 / 1;
  }

  #search {
    visibility: hidden;
  }

  .pagefind-ui .pf-searchbox {
    display: block !important;
    margin: 0 auto !important;
  }

  .skeleton-input {
    box-sizing: border-box;
    max-width: var(--pf-searchbox-max-width, 480px);
    margin: 0 auto;
    height: 36px;
    border-radius: 6px;
    border: 1px solid var(--color-500);
    background: var(--color-300);
    background-image: linear-gradient(
      90deg,
      var(--color-300) 25%,
      var(--color-500) 50%,
      var(--color-300) 75%
    );
    background-size: 800px 100%;
    animation: shimmer 1.4s infinite linear;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const skeleton = document.getElementById("search-skeleton");
    const searchEl = document.getElementById("search");

    function hideSkeleton() {
      if (skeleton) skeleton.style.display = "none";
      if (searchEl) searchEl.style.visibility = "visible";
    }

    const input = searchEl?.querySelector<HTMLInputElement>(".pf-searchbox-input");
    if (input) {
      hideSkeleton();
      input.setAttribute("aria-label", input.title || "Search");
    } else {
      const observer = new MutationObserver(() => {
        const el = searchEl?.querySelector<HTMLInputElement>(".pf-searchbox-input");
        if (el) {
          observer.disconnect();
          hideSkeleton();
          el.setAttribute("aria-label", el.title || "Search");
        }
      });
      if (searchEl) observer.observe(searchEl, { childList: true, subtree: true });
      setTimeout(hideSkeleton, 3000);
    }
  });
</script>
