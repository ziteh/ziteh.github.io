---
// https://disqus.com/admin/universalcode/

import { SITE } from "@/config";

export interface Props {
  url: string; // The canonical URL
  identifier: string; // A unique identifier
}

const { url, identifier } = Astro.props;
const disqusShortname = SITE.disqusShortname;
---

<span class="note"
  >這是 Disqus 留言板，你可能會看到它插入的廣告，留言可能不會立即顯示。若過了幾天仍未出現，請 <a
    href="mailto:honmonoh@gmail.com">Email</a
  > 聯繫：）</span
>
<div id="disqus_thread"></div>

<style>
  .note {
    margin: 1.25em 0;
    font-size: var(--font-size-xs);
    color: var(--color-700);
  }
  .note a {
    color: var(--color-700);
  }
</style>

<script is:inline define:vars={{ url, identifier, disqusShortname }}>
  (function () {
    var disqus_config = function () {
      this.page.url = url;
      this.page.identifier = identifier;
    };

    function loadDisqus() {
      var d = document,
        s = d.createElement("script");
      s.src = "https://" + disqusShortname + ".disqus.com/embed.js";
      s.setAttribute("data-timestamp", String(+new Date()));
      (d.head || d.body).appendChild(s);
    }

    function initDisqus() {
      var el = document.getElementById("disqus_thread");
      if (!el) return;
      var observer = new IntersectionObserver(
        function (entries) {
          if (entries[0].isIntersecting) {
            loadDisqus();
            observer.disconnect();
          }
        },
        { rootMargin: "200px" },
      );
      observer.observe(el);
    }

    initDisqus();
    document.addEventListener("astro:page-load", initDisqus);
  })();
</script>
<noscript
  >Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript"
    >comments powered by Disqus.</a
  ></noscript
>
