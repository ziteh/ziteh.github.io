# https://developers.cloudflare.com/pages/configuration/headers/

# Baseline security headers so this template works out of the box; tighten to fit your own deployment.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://*.disqus.com https://*.disquscdn.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://*.disquscdn.com; img-src 'self' data: https:; font-src 'self' https://*.disquscdn.com; frame-src https://disqus.com https://*.disqus.com https://www.youtube.com https://docs.google.com https://drive.google.com; connect-src 'self' https://*.disqus.com https://*.disquscdn.com https://cloudflareinsights.com; frame-ancestors 'self'
  Strict-Transport-Security: max-age=31556952; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/archives
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/archives/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/categories/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/tags/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/posts
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/posts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/og-images/*
  Cache-Control: public, max-age=31556952, immutable

/_astro/*
  Cache-Control: public, max-age=31556952, immutable

/pagefind/fragment/*
  Cache-Control: public, max-age=31556952, immutable

/pagefind/index/*
  Cache-Control: public, max-age=31556952, immutable
