{
  "name": "astro-theme-jing",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome check --write",
    "lint:check": "biome check",
    "type:check": "tsc --noEmit",
    "astro:check": "astro check",
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:urls": "playwright test tests/urls.spec.ts",
    "test:sidebar": "playwright test tests/sidebar.spec.ts",
    "test:expressive-code": "playwright test tests/expressive-code.spec.ts",
    "test:katex": "playwright test tests/katex.spec.ts",
    "test:search": "playwright test tests/search.spec.ts",
    "test:lh": "pnpm build && lhci autorun",
    "seonaut:up": "podman compose -f docker-compose-seonaut.yml up -d",
    "seonaut:down": "podman compose -f docker-compose-seonaut.yml down",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@microflash/rehype-figure": "^2.1.4",
    "astro": "^7.3.3",
    "astro-expressive-code": "^0.44.2",
    "astro-pagefind": "^2.0.1",
    "katex": "^0.16.45",
    "lodash.kebabcase": "^4.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4",
    "tocbot": "^4.36.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.11.2",
    "@biomejs/biome": "2.4.12",
    "@lhci/cli": "^0.15.1",
    "@playform/compress": "0.2.5",
    "@playwright/test": "^1.59.1",
    "@types/lodash.kebabcase": "^4.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss-custom-media": "^12.0.1",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "satori": "^0.26.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc,css,astro}": "biome check --write --no-errors-on-unmatched"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.1"
}
