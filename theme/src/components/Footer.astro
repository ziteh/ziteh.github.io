---
import { SITE, SOCIALS } from "@/config";

const today = new Date();
---

<footer>
  <span class="rights"
    >&copy;&nbsp;{today.getFullYear()}&nbsp;<a href="/about">{SITE.author}</a>. CC BY-NC-SA. Powered
    by <a href="https://github.com/ziteh/astro-jing-theme" target="_blank" rel="noopener noreferrer"
      >Astro Jing</a
    >.</span
  >
  <div class="social-links">
    {
      SOCIALS.map((social, i) => (
        <>
          {i > 0 && <span class="separator">·</span>}
          <a href={social.href} target="_blank" rel="noopener noreferrer">
            {social.title}
          </a>
        </>
      ))
    }
  </div>
</footer>

<style>
  @import "../styles/breakpoints.css";

  footer {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.5em 2.5em;
    color: var(--color-700);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-light);
  }
  .rights {
    order: 2;
  }
  .social-links {
    order: 1;
  }
  @media (--bp-md) {
    footer {
      flex-direction: row;
    }
    .rights,
    .social-links {
      order: 0;
    }
  }
  footer a {
    color: var(--color-700);
    text-decoration: none;
  }
  footer a:hover {
    color: var(--color-900);
    text-decoration: underline;
  }
  .social-links {
    display: flex;
    gap: 1em;
  }
</style>
